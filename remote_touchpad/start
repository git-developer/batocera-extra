#!/bin/sh
. "$(readlink -f "$(dirname "$0")")/.env"

{
  if [ -r "${tls_cert}" ] && [ -r "${tls_key}" ]; then
    printf '%s\0' "--filesystem=${tls_home}:ro" "${app_id}" -cert "${tls_cert}" -key "${tls_key}"
  else
    printf '%s\0' "${app_id}"
  fi
} | xargs -0 sh -c "
  DISPLAY="${DISPLAY:-:0}" \
  HOME="${HOME:-/userdata/system}" \
  DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/dbus/system_bus_socket}" \
  XAUTHORITY="${XAUTHORITY:-/var/lib/.Xauthority}" \
  flatpak run \"\${@}\" >>\"${log_file}\" 2>&1 &
" -
