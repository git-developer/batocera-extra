#!/bin/sh
set -eu
. "$(readlink -f "$(dirname "$0")")/.env"

main() {
  # patch-cemu-generator-for-cemuhook
  find /usr/lib/python*.*/site-packages/batocera_launch/emulators -name cemu.py.backup-cemuhook | while read backup; do
    mv "${backup}" "${backup%.backup-cemuhook}"
  done

  # patch-azahar-generator-for-cemuhook
  find /usr/lib/python*.*/site-packages/batocera_launch/emulators -name azahar.py.backup-cemuhook | while read backup; do
    mv "${backup}" "${backup%.backup-cemuhook}"
  done

  # patch-dolphin-generator-for-cemuhook
  find /usr/lib/python*.*/site-packages/batocera_launch_dolphin -name controllers.py.backup-cemuhook | while read backup; do
    mv "${backup}" "${backup%.backup-cemuhook}"
  done

  # patch-joycond-for-flatpak
  sed -i 's/MODE="0660", GROUP="input"/MODE="0600"/g' /etc/udev/rules.d/89-joycond.rules

  # patch-sony-controllers-for-flatpak
  rm /etc/udev/rules.d/99-sony-controllers.rules

  # no uninstall for 'relocate-root-dotfiles-to-home'
}

main "${@}"
