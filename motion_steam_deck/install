#!/bin/sh
set -eu
. "$(readlink -f "$(dirname "$0")")/.env"

main() {
  url="$(find_url)"
  timestamp="$(
    wget -q --spider -S "${url}" 2>&1 \
    | sed -nE 's/\s*Last-Modified: ([^\s].+)/\1/p' \
    | date -u '+%Y-%m-%d.%H-%m' -f -)"
  directory="${app_name}/${timestamp}"

  target="${XDG_CACHE_HOME:-/userdata/system/.cache}/${directory}"
  package="$(provide_package "${url}" "${target}")"

  unzip -j -o "${package}" "SteamDeckGyroDSUSetup/${app_name}" -d /usr/bin/
  chmod +x "/usr/bin/${app_name}"

  "${base_dir}/../bin/pkg" lib libtinfo.so.6 libncursesw.so.6 libsystemd.so.0
  if [ "$(uname -m)" != "x86_64" ]; then
    # 'add' instead of 'lib' to avoid an architechture mix in system's library path
    pkg add libhidapi-hidraw0==x86_64
  fi
  if [ ! -e /dev/usb ]; then
    mkdir /dev/usb
  fi
}

main "${@}"
