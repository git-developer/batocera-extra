base_dir="$(readlink -f "$(dirname "$0")")"
service_name="$(basename "${base_dir}")"
. "${base_dir}/../bin/package-support.sh"

app_name=linuxmotehook2
repo="v1993/${app_name}"
version=v0.2.1
log_dir=/userdata/system/logs/

find_url() {
  echo "https://github.com/${repo}/releases/download/${version}/${app_name}-${version}-$(uname -m).AppImage"
}

[ ! -r "${base_dir}/local.env" ] || . "${base_dir}/local.env"
